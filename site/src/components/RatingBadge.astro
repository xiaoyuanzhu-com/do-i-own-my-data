---
import type { Grade } from '../data/products';

interface Props {
  grade: Grade | undefined;
}
const { grade } = Astro.props;
const label = grade ?? '·';
const fullLabel = grade ?? 'Not rated';
const className = grade ? `grade-${grade}` : 'grade-none';
---
<span class={`grade-badge ${className}`} aria-label={fullLabel} title={fullLabel}>{label}</span>
