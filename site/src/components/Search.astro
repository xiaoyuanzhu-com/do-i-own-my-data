<div class="search-panel">
  <div class="search-box">
    <input
      type="search"
      id="search-input"
      placeholder="Product, vendor, or tag"
      autocomplete="off"
      aria-label="Search products"
    />
  </div>
  <p class="results-copy" data-search-results></p>
</div>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultCopy = document.querySelector('[data-search-results]') as HTMLParagraphElement | null;
  const emptyState = document.querySelector('[data-search-empty]') as HTMLElement | null;

  const normalize = (value: string) =>
    value
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[^\w\s-]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-item]'));
  const total = cards.length;

  const setSummary = (visible: number, query: string) => {
    if (!resultCopy) return;

    if (!query) {
      resultCopy.textContent = `${total} rated ${total === 1 ? 'product' : 'products'} across six ownership checks.`;
      return;
    }

    resultCopy.textContent = visible === 0
      ? `No matches for “${query}”.`
      : `${visible} ${visible === 1 ? 'match' : 'matches'} for “${query}”.`;
  };

  const update = () => {
    const query = normalize(input?.value || '');
    let visible = 0;

    cards.forEach((card) => {
      const haystack = normalize(card.dataset.search || '');
      const match = !query || haystack.includes(query);
      card.hidden = !match;
      if (match) visible += 1;
    });

    if (emptyState) {
      emptyState.hidden = visible !== 0;
    }

    setSummary(visible, input?.value.trim() || '');
  };

  setSummary(total, '');
  input?.addEventListener('input', update);
</script>
