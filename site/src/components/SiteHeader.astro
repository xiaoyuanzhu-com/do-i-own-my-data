---
interface Props {
  variant?: 'solid' | 'soft' | 'minimal' | 'block';
  sticky?: boolean;
}

const {
  variant = 'solid',
  sticky = true,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const headerClass = ['site-header', sticky ? '' : 'is-static'].filter(Boolean).join(' ');
---
<header class={headerClass} data-header-variant={variant}>
  <nav class="site-nav" aria-label="Primary">
    <a href={base} class="site-title">
      <span class="site-title-mark">Do I Own My Data?</span>
    </a>
    <div class="nav-links">
      <a href={`${base}about`}>About</a>
      <a href="https://github.com/xiaoyuanzhu-com/do-i-own-my-data" target="_blank" rel="noreferrer">GitHub</a>
    </div>
  </nav>
</header>
