---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
  headerVariant?: 'solid' | 'soft' | 'minimal' | 'block';
  hideHeader?: boolean;
  hideFooter?: boolean;
}
const {
  title,
  description = 'A community-driven directory that rates products on data ownership friendliness.',
  headerVariant = 'soft',
  hideHeader = false,
  hideFooter = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe7" />
    <title>{title} — Do I Own My Data?</title>
  </head>
  <body>
    {!hideHeader && <SiteHeader variant={headerVariant} />}
    <main class="site-main">
      <div class="page-shell">
        <slot />
      </div>
    </main>
    {!hideFooter && (
      <footer class="site-footer">
        <div class="footer-copy">
          <p class="footer-title">Public ratings for products that hold your data.</p>
        </div>
      </footer>
    )}
  </body>
</html>
