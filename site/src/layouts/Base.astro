---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A community-driven directory that rates products on data ownership friendliness." />
    <title>{title} — Do I Own My Data?</title>
  </head>
  <body>
    <header>
      <nav>
        <a href={base} class="site-title">Do I Own My Data?</a>
        <div class="nav-links">
          <a href={base}>Products</a>
          <a href={`${base}about`}>About</a>
          <a href="https://github.com/xiaoyuanzhu-com/do-i-own-my-data" target="_blank">GitHub</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        <a href="https://github.com/xiaoyuanzhu-com/do-i-own-my-data" target="_blank">Contribute on GitHub</a>
        · Licensed under MIT
      </p>
    </footer>
  </body>
</html>
