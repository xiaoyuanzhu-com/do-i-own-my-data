---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'A community-driven directory that rates products on data ownership friendliness.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe7" />
    <title>{title} — Do I Own My Data?</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav">
        <a href={base} class="site-title">
          <span class="site-title-mark">Do I Own My Data?</span>
          <span class="site-title-note">evidence-backed product ratings</span>
        </a>
        <div class="nav-links">
          <a href={base}>Products</a>
          <a href={`${base}about`}>About</a>
          <a href="https://github.com/xiaoyuanzhu-com/do-i-own-my-data" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </nav>
    </header>
    <main class="site-main">
      <div class="page-shell">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="footer-copy">
        <p class="footer-title">Public ratings for products that hold your data.</p>
        <p>
          <a href="https://github.com/xiaoyuanzhu-com/do-i-own-my-data" target="_blank" rel="noreferrer">Contribute on GitHub</a>
          <span class="footer-separator">·</span>
          Licensed under MIT
        </p>
      </div>
    </footer>
  </body>
</html>
